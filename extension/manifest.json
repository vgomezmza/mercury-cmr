{
  "manifest_version": 3,
  "name": "Mercury CRM - WhatsApp Web Bridge",
  "version": "1.0.0",
  "description": "Vincula WhatsApp Web con Mercury CRM en la nube para sincronizar chats, leer respuestas y registrar prospectos con 1 clic.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configuración Mercury CRM"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
